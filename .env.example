# ==============================================================================
# ProsperHigh Environment Configuration
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
ENVIRONMENT=development

# Database Connection URL
# Production: PostgreSQL (e.g. postgresql+psycopg2://user:password@host:5432/prosperhigh)
# Local Development default: SQLite file
DATABASE_URL=sqlite:///./prosperhigh.db

# Authentication / JWT Configuration
# In production, generate a strong random 256-bit secret (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=dev-secret-key-change-this-in-production-to-a-secure-random-32char-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated list)
# In production, set to your frontend domain (e.g. https://prosperhigh.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Configuration ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO

# AI Provider Configuration (Model-Agnostic Decision Router)
PRIMARY_LLM_PROVIDER=gemini
SECONDARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=local_qwen

# AI API Keys (leave empty to use deterministic rule synthesis fallback)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b
