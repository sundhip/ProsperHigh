# ==============================================================================
# ProsperHigh Platform — Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
APP_NAME="ProsperHigh Platform API"
APP_VERSION=3.2.0
DEBUG=false
LOG_LEVEL=INFO

# Database Connection URL (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=postgresql://prosperhigh_user:prosperhigh_secure_password@localhost:5432/prosperhigh_prod

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# Authentication & JWT Security
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_cryptographically_secure_random_64_character_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_RESEARCH_PER_MINUTE=40
RATE_LIMIT_GENERAL_PER_MINUTE=120

# CORS Allowed Origins (Comma-separated list)
ALLOWED_ORIGINS=https://app.prosperhigh.com,http://localhost:3000

# AI Provider Credentials & Selection
PRIMARY_LLM_PROVIDER=gemini
SECONDARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=deterministic

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:8b

# AI Concurrency & Cost Safeguards
AI_MAX_CONCURRENT_ANALYSES=8
AI_ANALYSIS_TIMEOUT_SECONDS=30
AI_AGENT_TIMEOUT_SECONDS=10

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
